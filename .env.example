# Copy to .env for local runs. Never commit real values.

APP_ENV=development
PUBLIC_BASE_URL=https://your-service.onrender.com

# Shared secret the voice platform sends on every request:
#   Authorization: Bearer <TOOL_WEBHOOK_SECRET>   (or X-Webhook-Secret: <TOOL_WEBHOOK_SECRET>)
# python -c "import secrets; print(secrets.token_hex(32))"
TOOL_WEBHOOK_SECRET=

# Neon: `neon link` writes both into .env.local for you, or copy them from Dashboard -> Connect. The app uses the POOLED string (host contains "-pooler").
# Migrations use the DIRECT string (same host without "-pooler").
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# python -c "import secrets; print(secrets.token_hex(32))"
PHONE_HASH_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PHONE_ENCRYPTION_KEY=

# Path to the service-account JSON file, or the JSON itself
GOOGLE_SERVICE_ACCOUNT_JSON=

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_STUDIO_HEAD_CHAT_ID=
TELEGRAM_FRONT_DESK_CHAT_ID=

# console | twilio
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

STUDIO_ADDRESS=
PORTFOLIO_URL=

CRON_SECRET=

# Cost model (INR). USD_INR_RATE converts platform_cost_usd from the end-of-call report.
USD_INR_RATE=
TELEPHONY_COST_INR_PER_MIN=
FIXED_MONTHLY_COST_INR=

# Website receptionist demo. Set one key (Gemini from https://aistudio.google.com/apikey,
# or Claude). Every visitor message costs API usage, capped by the two limits below.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# auto | gemini | claude. auto picks Gemini when GEMINI_API_KEY is set, else Claude.
DEMO_PROVIDER=auto
# Blank uses gemini-3.8-flash (Gemini) or claude-opus-5-5 (Claude).
DEMO_MODEL=
# low | medium | high (Claude effort / Gemini thinking level). Lower answers faster.
DEMO_EFFORT=low
DEMO_DAILY_TURN_LIMIT=300
DEMO_SESSION_TURN_LIMIT=30
